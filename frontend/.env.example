# Frontend Environment Variables
# Copy this file to .env.local and update values as needed

# API URL - Backend server URL
# Leave empty or unset for default behavior:
# - Development (npm run dev): defaults to http://localhost:8000
# - Production (Docker): defaults to empty (nginx proxies /api to backend)
# VITE_API_URL=http://localhost:8000

# For custom backend URL (e.g., staging environment):
# VITE_API_URL=https://api.staging.example.com
